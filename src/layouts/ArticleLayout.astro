---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE } from 'astrowind:config';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'reviews' | 'comparisons' | 'guides' | 'verticals'>;
  Content: any;
  sectionLabel: string;
  sectionHref: string;
}

const { entry, Content, sectionLabel, sectionHref } = Astro.props;
const { title, description, date, updated, faq } = entry.data as any;
const site = (SITE?.site || 'https://example.com').replace(/\/$/, '');
const url = `${site}${Astro.url.pathname}`;

const metadata = {
  title,
  description,
  openGraph: { type: 'article' },
};

// JSON-LD: Article (+ FAQPage when the entry carries faq frontmatter).
// Honesty gate: no ratings, prices, or review counts are ever invented here.
const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url,
    datePublished: new Date(date).toISOString(),
    ...(updated ? { dateModified: new Date(updated).toISOString() } : {}),
    author: {
      '@type': 'Person',
      name: 'Jason O\u2019Keefe',
      url: `${site}/about/`,
    },
    publisher: {
      '@type': 'Organization',
      name: 'Burr & Brew',
      url: site,
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: sectionLabel, item: `${site}${sectionHref}` },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];

if (faq && faq.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f: { q: string; a: string }) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schemas} />

  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href={sectionHref} class="hover:text-primary">{sectionLabel}</a>
    </nav>

    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">{sectionLabel}</p>
    <h1 class="font-headline text-4xl font-bold leading-tight md:text-5xl">{title}</h1>
    <p class="mt-4 text-xl text-muted">{description}</p>

    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 border-y border-stone-200 py-3 text-sm text-muted dark:border-stone-800">
      <span>By <a href="/about/" class="font-medium text-default hover:text-primary">Jason O&rsquo;Keefe</a></span>
      <span aria-hidden="true">·</span>
      <time datetime={new Date(date).toISOString()}>{fmt(date)}</time>
      {updated && (
        <>
          <span aria-hidden="true">·</span>
          <span>Updated <time datetime={new Date(updated).toISOString()}>{fmt(updated)}</time></span>
        </>
      )}
    </div>

    <div class="prose-editorial prose prose-lg mt-8 dark:prose-invert">
      <Content />
    </div>

    {faq && faq.length > 0 && (
      <section aria-label="Frequently asked questions" class="mt-12">
        <h2 class="font-headline text-2xl font-bold">Frequently asked questions</h2>
        <div class="mt-4 divide-y divide-stone-200 dark:divide-stone-800">
          {faq.map((f: { q: string; a: string }) => (
            <details class="group py-4">
              <summary class="cursor-pointer font-medium text-default hover:text-primary">{f.q}</summary>
              <p class="mt-2 text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <aside class="mt-12 rounded-lg border border-stone-200 bg-stone-100 p-5 text-sm text-muted dark:border-stone-800 dark:bg-stone-900">
      <p>
        <strong class="text-default">Affiliate disclosure:</strong> Burr & Brew is reader-supported. When you
        buy through links on this page, we may earn a commission at no extra cost to you.{' '}
        <a href="/affiliate-disclosure/" class="underline hover:text-primary">Read our full disclosure</a>.
      </p>
    </aside>
  </article>
</Layout>
