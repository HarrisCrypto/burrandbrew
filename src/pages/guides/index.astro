---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ArticleCard from '~/components/ArticleCard.astro';
import { SITE } from 'astrowind:config';

const entries = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
);

const metadata = {
  title: 'Home Coffee & Espresso Guides',
  description:
    'Step-by-step brewing how-tos and what-to-look-for buying guides for home coffee and espresso gear.',
};

const site = (SITE?.site || 'https://example.com').replace(/\/$/, '');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Home Coffee & Espresso Guides',
  description: metadata.description,
  url: `${site}/guides/`,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">Guides</p>
    <h1 class="font-headline mt-2 text-4xl font-bold md:text-5xl">Brewing guides</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Everything you need to brew better coffee at home — technique first, gear second.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <ArticleCard
          href={`/guides/${entry.id.replace(/\.mdx?$/, '')}/`}
          kicker="Guide"
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
        />
      ))}
    </div>
  </section>
</Layout>
