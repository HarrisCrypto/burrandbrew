---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ArticleCard from '~/components/ArticleCard.astro';
import { SITE } from 'astrowind:config';

const entries = (await getCollection('comparisons', ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
);

const metadata = {
  title: 'Coffee Comparisons — Method vs Method',
  description:
    'Side-by-side comparisons of brew methods and gear: how each works, how the cup differs, and who each one is actually for.'
};

const site = (SITE?.site || 'https://example.com').replace(/\/$/, '');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Coffee Comparisons',
  description: metadata.description,
  url: `${site}/comparisons/`,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">Comparisons</p>
    <h1 class="font-headline mt-2 text-4xl font-bold md:text-5xl">Head to head</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Side-by-side comparisons: pricing, features, and who each service is actually for.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => (
        <ArticleCard
          href={`/comparisons/${entry.id.replace(/\.mdx?$/, '')}/`}
          kicker="Comparison"
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
        />
      ))}
    </div>
  </section>
</Layout>
